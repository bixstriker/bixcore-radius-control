FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN groupadd --gid 10005 bixrpc \
    && useradd --uid 10002 --gid bixrpc --create-home --home-dir /home/bixsync --shell /usr/sbin/nologin bixsync \
    && useradd --uid 10003 --gid bixrpc --create-home --home-dir /home/bixcontrol --shell /usr/sbin/nologin bixcontrol
COPY app /app/app
COPY sync /app/sync
COPY data /app/data
