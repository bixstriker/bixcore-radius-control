FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd --system --uid 10001 --home /app --shell /usr/sbin/nologin radiusui
COPY app /app/app
COPY data /app/data
USER 10001:10001
EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8765/api/health',timeout=2)" || exit 1
CMD ["uvicorn","app.main:app","--host","0.0.0.0","--port","8765","--no-access-log"]
